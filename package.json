{
  "name": "warden-sandbox",
  "version": "0.1.1",
  "description": "Runtime capability sandboxing for Node.js dependencies",
  "type": "commonjs",
  "bin": {
    "warden": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/runtime/esmHooks.mjs', 'dist/runtime/esmHooks.mjs')\"",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "security",
    "sandbox",
    "npm",
    "supply-chain",
    "compartment"
  ],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-seize/Warden.git"
  },
  "homepage": "https://github.com/r-seize/Warden#readme",
  "bugs": {
    "url": "https://github.com/r-seize/Warden/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "chalk": "^4.1.2",
    "commander": "^15.0.0",
    "ses": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
